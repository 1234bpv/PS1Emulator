// Демон розгортання: приймає файли й запускає застосунки по WiFi/TCP.
// Самодостатній, ядра емулятора не лінкує.

TARGET          ps1daemon.exe
TARGETTYPE      exe
UID             0 0xE0001004
SECUREID        0xE0001004
VENDORID        0

// NetworkServices - сокети; ReadUserData - RConnection; ReadDeviceData - читання
// CommDb для пошуку IAP "Netis" (автопідключення). ReadDeviceData не входить у
// самопідписний набір, тож пакет ставиться лише на зламаному апараті (Install
// Server), що для нашого демона й так виконано.
CAPABILITY      NetworkServices ReadUserData ReadDeviceData

EPOCSTACKSIZE   0x5000

SOURCEPATH      ..\..\..\src\symbian
SOURCE          deploy_daemon.cpp

START RESOURCE  daemon_reg.rss
TARGETPATH      \private\10003a3f\import\apps
END

// Автозапуск при завантаженні: sysstart читає .rsc із цього import-каталогу.
START RESOURCE  daemon_startup.rss
TARGETPATH      \private\101f875a\import
END

SYSTEMINCLUDE   \epoc32\include

LIBRARY         euser.lib
LIBRARY         efsrv.lib
LIBRARY         esock.lib
LIBRARY         insock.lib
LIBRARY         commdb.lib
