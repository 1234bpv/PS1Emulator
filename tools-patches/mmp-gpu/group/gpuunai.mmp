// gpu_unai + gpulib for Symbian - Stage 2: rasterisation without display output.
//
// WARNING: this .mmp no longer builds the library in the default path. gpuunai.lib
// is built by tools-patches\gpu463-regen.cmd with GCCE 4.6.3 compiler - in a benchmark
// of 9000 frames this gives rasteriser -8.3%, whole frame -3.0%, drawing counters
// match one to one. The file remains as a record of composition and macros; if
// built via abld, it will overwrite the library with the CSL 3.4.3 version.
//
// P16: assembler gpu_arm.S is not built by GAS from CSL 3.4.3 (does not substitute
// macro parameters inside .if - fails on every macro call). Bypassed:
// the file is built with the newer GCCE 4.6.3 assembler and supplied to link as a separate
// library gpuasm.lib (tools-patches\gpuasm-regen.cmd), the rest as before.
// Profile of the racing phase showed that these loops dominate.

TARGET          gpuunai.lib
TARGETTYPE      lib

// The same flags as in the core (P7, P8, P13 - see pcsxcore.mmp).
OPTION GCCE     -march=armv6 -mtune=arm1136j-s -fomit-frame-pointer -D__SIZEOF_POINTER__=4 -DP_HAVE_MMAP=0 \
                -D__ORDER_LITTLE_ENDIAN__=1234 -D__ORDER_BIG_ENDIAN__=4321 \
                -D__ORDER_PDP_ENDIAN__=3412 -D__BYTE_ORDER__=1234

MACRO           REARMED
MACRO           USE_GPULIB=1
// GPU_UNAI_ARM_ASM is enabled in gpu_unai.h automatically unless explicitly disabled.

SOURCEPATH      ..\..\..\pcsx_rearmed\plugins\gpulib
SOURCE          gpu.c
SOURCE          prim.c

SOURCEPATH      ..\..\..\pcsx_rearmed\plugins\gpu_unai
SOURCE          gpulib_if.cpp

// Old rasteriser: gpulib_if.cpp switches to it via
// IS_OLD_RENDERER(), so without this file it does not link.
SOURCEPATH      ..\..\..\pcsx_rearmed\plugins\gpu_unai\old
SOURCE          if.cpp

USERINCLUDE     ..\..\..\src\compat
USERINCLUDE     ..\..\..\pcsx_rearmed
USERINCLUDE     ..\..\..\pcsx_rearmed\include
USERINCLUDE     ..\..\..\pcsx_rearmed\libpcsxcore
USERINCLUDE     ..\..\..\pcsx_rearmed\plugins\gpulib
USERINCLUDE     ..\..\..\pcsx_rearmed\plugins\gpu_unai

SYSTEMINCLUDE   \epoc32\include
SYSTEMINCLUDE   \epoc32\include\libc
