// Stage 0: executable memory probe. Self-contained, does not link emulator core.

TARGET          ps1stage0.exe
TARGETTYPE      exe
UID             0 0xE0001003
SECUREID        0xE0001003
VENDORID        0

// Deliberately None: one question of the probe is whether a capability is needed for
// RChunk::CreateLocalCode. If needed, KErrPermissionDenied (-46) will result.
CAPABILITY      None

EPOCSTACKSIZE   0x5000

SOURCEPATH      ..\..\..\src\symbian
SOURCE          stage0_probe.cpp

// Path is relative to SOURCEPATH above, not to .mmp.
START RESOURCE  stage0_reg.rss
TARGETPATH      \private\10003a3f\import\apps
END

SYSTEMINCLUDE   \epoc32\include

LIBRARY         euser.lib
LIBRARY         efsrv.lib
