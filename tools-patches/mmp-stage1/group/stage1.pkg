; Stage 1: PlayStation core with the ari64 dynarec. Self-signed, CAPABILITY SwEvent (needed by CaptureKey for the side keys).
; ASCII only, CRLF only: makesis misparses UTF-8 and LF line endings.
; Shaped like daemon.pkg, the one package this phone does install - executable
; plus registration resource only. The app resource is delivered by the deploy
; daemon instead, which is proven to work, until we know what the installer
; objects to. The icon is in the package, but the registration now takes caption and
; icon from ps1stage1.rsc, so the phone needs the current one (run.ps1 -Resources).
&EN

#{"PS1Emulator alpha 1.4.1"},(0xE0001002),1,4,1

%{"PS1Emulator"}
:"PS1Emulator"

[0x101F7961],0,0,0,{"Series60ProductID"}

"\VsCodeProjects\SymbianProjects\S60_3rd_FP1\Epoc32\release\gcce\urel\ps1stage1.exe"-"!:\sys\bin\ps1stage1.exe"
; Window server anim of the Slider base: renames the media keys the firmware would eat.
"\VsCodeProjects\SymbianProjects\S60_3rd_FP1\Epoc32\release\gcce\urel\ps1slide.dll"-"!:\sys\bin\ps1slide.dll"
"\VsCodeProjects\SymbianProjects\S60_3rd_FP1\Epoc32\data\z\private\10003a3f\import\apps\ps1stage1_reg.RSC"-"!:\private\10003a3f\import\apps\ps1stage1_reg.rsc"
"\VsCodeProjects\SymbianProjects\S60_3rd_FP1\Epoc32\data\z\resource\apps\ps1stage1_aif.mbm"-"!:\resource\apps\ps1stage1_aif.mbm"
; Help texts and menu hints, one file per interface language (English is the fallback).
"\VsCodeProjects\SymbianProjects\PS1Emulator\help\en.txt"-"E:\PS1\help\en.txt"
"\VsCodeProjects\SymbianProjects\PS1Emulator\help\uk.txt"-"E:\PS1\help\uk.txt"
