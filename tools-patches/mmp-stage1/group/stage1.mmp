// Етап 1: EXE, що лінкує pcsxcore.lib і рахує кадри без виведення.

TARGET          ps1stage1.exe
TARGETTYPE      exe
UID             0 0xE0001002
SECUREID        0xE0001002
VENDORID        0

// Файлові операції для JSONL-логу; більше нічого не потрібно.
CAPABILITY      None

// Штатний стек. Рекомпіляторові його вистачає лише тому, що struct
// compile_state (64 КБ на MAXBLOCK-масивах) винесено зі стеку у форку.
// Збільшувати не варіант: апарат відмовляє і процесу з завеликим
// EPOCSTACKSIZE (мовчки, ще до E32Main), і потоку - RThread::Create
// повертає KErrTooBig на 512 КБ. У EKA2L1 обидві величини проходили.
EPOCSTACKSIZE   0x14000
// Гість PS1: 2 МБ ОЗП + 512 КБ BIOS + 1 МБ VRAM + структури ядра.
EPOCHEAPSIZE    0x100000 0x1000000

// Ті самі прапорці, що й у ядра. P13: без ORDER-макросів CSL 3.4.3 бере
// big-endian гілку; заголовки ядра тут теж їх читають.
OPTION GCCE     -march=armv6 -D__SIZEOF_POINTER__=4 -DP_HAVE_MMAP=0 \
                -D__ORDER_LITTLE_ENDIAN__=1234 -D__ORDER_BIG_ENDIAN__=4321 \
                -D__ORDER_PDP_ENDIAN__=3412 -D__BYTE_ORDER__=1234

// Мусить збігатися з pcsxcore.mmp: заголовки динареку читають цей макрос.
MACRO           BASE_ADDR_DYNAMIC=1

SOURCEPATH      ..\..\..\src\symbian
SOURCE          stage1.cpp
SOURCE          vout_symbian.cpp
// Glue звуку: обгортки ps1Spu* над dfsound + out-драйвер (окремо від plugins.h).
SOURCE          snd_symbian.cpp
// Платформна заміна mmap(PROT_EXEC)/__clear_cache для динареку.
SOURCE          ndrc_mem_symbian.cpp

// Звук: dfsound (портабельна гілка). spu.c втягує reverb/adsr/xa через #include.
// NEON off (потребує ARMv7+__ARM_NEON__), ssat під HAVE_ARMV6 - безпечно для ARM11.
SOURCEPATH      ..\..\..\pcsx_rearmed\plugins\dfsound
SOURCE          spu.c registers.c dma.c freeze.c out.c nullsnd.c

// mix_chan/mix_chan_rvb: HAVE_ARMV5 (від -march=armv6) вмикає asm-версії в spu.c.
// Попередньо оброблено (..\asm), як gte_arm - abld не запускає cpp на .s. Regen: ..\asm\regen.cmd
SOURCEPATH      ..\asm
SOURCE          arm_utils.s

SOURCEPATH      ..\..\..\src\symbian
// Шлях відносний до SOURCEPATH вище, не до .mmp.
START RESOURCE  stage1_reg.rss
TARGETPATH      \private\10003a3f\import\apps
END

// ESTLIB не має snprintf/vsnprintf (C99); у SDK їх немає в жодній .dso.
SOURCEPATH      ..\..\..\src\compat
SOURCE          compat_snprintf.c

USERINCLUDE     ..\..\..\src\compat
USERINCLUDE     ..\..\..\pcsx_rearmed
USERINCLUDE     ..\..\..\pcsx_rearmed\include
USERINCLUDE     ..\..\..\pcsx_rearmed\libpcsxcore
USERINCLUDE     ..\..\..\pcsx_rearmed\plugins\gpulib
USERINCLUDE     ..\..\..\pcsx_rearmed\plugins\dfsound

SYSTEMINCLUDE   \epoc32\include
SYSTEMINCLUDE   \epoc32\include\libc

STATICLIBRARY   gpuunai.lib
STATICLIBRARY   pcsxcore.lib
LIBRARY         euser.lib
LIBRARY         hal.lib
LIBRARY         estlib.lib
// Виведення кадру на екран (Етап 2): window server + FBS bitmap.
LIBRARY         ws32.lib
LIBRARY         fbscli.lib
// Звук: потоковий вивід PCM у динамік (CMdaAudioOutputStream).
LIBRARY         mediaclientaudiostream.lib
// DSA: CFbsBitGc/CFbsScreenDevice (прямий вивід у буфер екрана).
LIBRARY         bitgdi.lib
