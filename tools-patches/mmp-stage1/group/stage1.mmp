// Stage 1: EXE that links pcsxcore.lib and counts frames without display.

TARGET          ps1stage1.exe
TARGETTYPE      exe
// UID2 is zero, like in the daemon: the registration file makes the EXE an app, not UID2.
// 0x100039CE only added risk here - the daemon with UID2=0 is visible in the menu and its
// package installs, while ours with 0x100039CE does not.
UID             0 0xE0001002
SECUREID        0xE0001002
VENDORID        0

// The JSONL log needs nothing, but the performance-counter probe opens the
// dvfs and patcher channels, which check PowerMgmt and WriteDeviceData. The
// device runs this binary by registered hash, so the set costs no signing.
CAPABILITY      PowerMgmt WriteDeviceData ReadDeviceData ReadUserData WriteUserData ProtServ

// Standard stack. It is sufficient for the recompiler only because struct
// compile_state (64 KB for MAXBLOCK arrays) was moved off the stack in the fork.
// Increasing is not an option: the device rejects both a process with an overly large
// EPOCSTACKSIZE (silently, before E32Main) and a thread - RThread::Create
// returns KErrTooBig at 512 KB. In EKA2L1 both values passed.
EPOCSTACKSIZE   0x14000
// PS1 guest: 2 MB RAM + 512 KB BIOS + 1 MB VRAM + core structures.
// Upper bound - 40 MB: dynarec metadata (blocks, jump lists, hash tables)
// grow with each new block, and 16 MB was exhausted during track
// loading. This is a growth ceiling, not reservation - it takes no free memory.
EPOCHEAPSIZE    0x100000 0x2800000

// The same flags as in the core. P13: without ORDER macros CSL 3.4.3 takes
// the big-endian branch; core headers here read them as well.
// Do NOT enable -funit-at-a-time here (only in pcsxcore/gpuunai): with it GCC 3.4.3
// emits out-of-line copies of inline virtual methods from MMF headers
// (MDataSource/MDataSink), and linking fails on TMMFMessage::Complete and
// REComSession::DestroyedImplementation. That is why the SDK disables it.
// Z7_ST: in LZMA SDK 24.x single-threaded mode is named this, not _7ZIP_ST.
// A second OPTION GCCE line cannot be here - it replaces this one rather than appending.
OPTION GCCE     -march=armv6 -mtune=arm1136j-s -fomit-frame-pointer -D__SIZEOF_POINTER__=4 -DP_HAVE_MMAP=0 \
                -D__ORDER_LITTLE_ENDIAN__=1234 -D__ORDER_BIG_ENDIAN__=4321 \
                -D__ORDER_PDP_ENDIAN__=3412 -D__BYTE_ORDER__=1234 -DZ7_ST=1 \
                -DMY_CPU_LE=1 -DMY_CPU_32BIT=1

// Must match pcsxcore.mmp: dynarec headers read this macro.
MACRO           BASE_ADDR_DYNAMIC=1

// Bench instrumentation gate: PMU counters (pmu_symbian.cpp), per-phase timers
// in vout_symbian.cpp, and the stand-only argument parsing in stage1.cpp all sit
// behind this. Without it the build is the plain playable release. See run.ps1 -Release.
MACRO           PS1_BENCH

SOURCEPATH      ..\..\..\src\symbian
SOURCE          stage1.cpp
SOURCE          vout_symbian.cpp
// PS1 rasteriser on MBX via GL ES 1.1 (report section 14).
SOURCE          glrender.cpp
// AVKON shell: window under CCoeEnv (needed by EGL), exit, orientation.
SOURCE          app_symbian.cpp
SOURCE          i18n.cpp
// Accelerometer through the ROM sensor library; absent from the SDK.
SOURCE          accel.cpp
// ARM1136 performance counters. They need kernel mode, so this pulls in the
// overclock engine of the neighbouring project, which already has the way in.
SOURCE          pmu_symbian.cpp
// Sound glue: ps1Spu* wrappers over dfsound + out-driver (separate from plugins.h).
SOURCE          snd_symbian.cpp
// Platform replacement of mmap(PROT_EXEC)/__clear_cache for the dynarec.
SOURCE          ndrc_mem_symbian.cpp
// Game import: .cue -> PBP with zeroed ECC, archive extraction.
SOURCE          imgconv.cpp
SOURCE          archive.cpp
SOURCE          arc7z.cpp
SOURCE          arcrar.cpp

// LZMA SDK (public domain) - .7z header parsing and streaming decompression.
SOURCEPATH      ..\..\..\src\lzma
// 7zDec.c is needed not for data decompression (we stream it ourselves), but
// because the .7z header itself is compressed, and 7zArcIn.c decodes it via
// SzAr_DecodeFolder. Filters are from there too, for headers with a coder chain.
SOURCE          7zArcIn.c 7zBuf.c 7zCrc.c 7zCrcOpt.c 7zDec.c 7zStream.c
SOURCE          CpuArch.c LzmaDec.c Lzma2Dec.c
SOURCE          Bcj2.c Bra.c Bra86.c BraIA64.c Delta.c

SOURCEPATH      ..\..\..\src\symbian

// Sound: dfsound (portable branch). spu.c pulls reverb/adsr/xa via #include.
// NEON off (requires ARMv7+__ARM_NEON__), ssat under HAVE_ARMV6 - safe for ARM11.
SOURCEPATH      ..\..\..\pcsx_rearmed\plugins\dfsound
SOURCE          spu.c registers.c dma.c freeze.c out.c nullsnd.c

// mix_chan/mix_chan_rvb: HAVE_ARMV5 (from -march=armv6) enables asm versions in spu.c.
// Preprocessed (..\asm), like gte_arm - abld does not run cpp on .s. Regen: ..\asm\regen.cmd
SOURCEPATH      ..\asm
SOURCE          arm_utils.s

SOURCEPATH      ..\..\..\src\symbian
// Application resource. Name must match app_file in stage1_reg.rss -
// the framework searches for exactly \resource\apps\<app_file>.rsc.
START RESOURCE  stage1.rss
TARGET          ps1stage1
TARGETPATH      \resource\apps
END

// Registration. apparc requires the name to be exactly <app_file>_reg.rsc, otherwise
// the entry is not picked up. Path is relative to SOURCEPATH above, not to .mmp.
START RESOURCE  ps1stage1_reg.rss
TARGETPATH      \private\10003a3f\import\apps
END

// ESTLIB lacks snprintf/vsnprintf (C99); in the SDK they are not in any .dso.
// The overclock engine of the neighbouring project already knows how to run
// a blob in kernel mode on this device, which is what CP15 access needs.
SOURCEPATH      ..\..\..\..\SymbianOverclock\src
SOURCE          ocengine.cpp

SOURCEPATH      ..\..\..\src\compat
SOURCE          compat_snprintf.c
// __aeabi_idiv/__aeabi_uidiv: needed by objects from GCCE 4.6.3, the system does not
// export them (only *divmod, which 3.4.3 calls). See compensation in the file.
SOURCE          compat_aeabi.c

USERINCLUDE     ..\..\..\src\compat
USERINCLUDE     ..\..\..\..\SymbianOverclock\src
USERINCLUDE     ..\..\..\src\lzma
// zlib: DEFLATE when building .pbp and INFLATE when reading .zip.
USERINCLUDE     ..\..\..\pcsx_rearmed\deps\libchdr\deps\zlib-1.3.1
USERINCLUDE     ..\..\..\pcsx_rearmed
USERINCLUDE     ..\..\..\pcsx_rearmed\include
USERINCLUDE     ..\..\..\pcsx_rearmed\libpcsxcore
USERINCLUDE     ..\..\..\pcsx_rearmed\plugins\gpulib
USERINCLUDE     ..\..\..\pcsx_rearmed\libpcsxcore\new_dynarec
USERINCLUDE     ..\..\..\pcsx_rearmed\plugins\dfsound

SYSTEMINCLUDE   \epoc32\include
SYSTEMINCLUDE   \epoc32\include\libc

STATICLIBRARY   gpuunai.lib
// Hand-written ARM rasteriser loops. Built separately with a newer assembler -
// see comment in gpuunai.mmp and tools-patches\gpuasm-regen.cmd.
STATICLIBRARY   gpuasm.lib
STATICLIBRARY   pcsxcore.lib
LIBRARY         euser.lib
LIBRARY         hal.lib
LIBRARY         sysutil.lib
LIBRARY         estlib.lib
// Frame display on screen (Stage 2): window server + FBS bitmap.
LIBRARY         ws32.lib
LIBRARY         fbscli.lib
// Sound: PCM audio streaming to speaker (CMdaAudioOutputStream).
LIBRARY         mediaclientaudiostream.lib
// DSA: CFbsBitGc/CFbsScreenDevice (direct output to screen buffer).
LIBRARY         bitgdi.lib
// GL ES output (MBX): EGL + OpenGL ES 1.1.
LIBRARY         libgles_cm.lib
// AVKON shell: CApaApplication, CCoeEnv/CCoeControl, EikStart/CEikonEnv,
// CAknAppUi, CEikStatusPane/CEikButtonGroupContainer.
LIBRARY         apparc.lib
LIBRARY         cone.lib
LIBRARY         eikcore.lib
LIBRARY         eikcoctl.lib
LIBRARY         avkon.lib
LIBRARY         efsrv.lib
LIBRARY         apgrfx.lib
// Settings menu: CDesCArrayFlat (image list) and CFont metrics.
LIBRARY         estor.lib
LIBRARY         bafl.lib
LIBRARY         gdi.lib
