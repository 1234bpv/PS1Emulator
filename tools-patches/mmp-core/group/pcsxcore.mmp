// libpcsxcore for Symbian - PlayStation core with ari64 dynarec (Stage 3).
// Static library: verifies core compilability separately from the shell.
// Problem areas - docs/architecture/data-spec.md

TARGET          pcsxcore.lib
TARGETTYPE      lib

// P8: SDK lacks an ARMv6 GCCE platform, target is specified by flag.
// P7: __SIZEOF_POINTER__ appeared in GCC 4.3; bundled CSL 3.4.3 lacks it.
// Byte order. GCC 3.4.3 does not define __BYTE_ORDER__ (appeared in 4.6), and in #if
// an undefined macro equals 0, so `__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__`
// becomes `0 == 0` and the core was built on the BIG-ENDIAN branch: psxmem.h:30 (memory
// access), r3000a.h:82 (register layout), cdrom.c:1350. Values are as in GCC 4.6+.
OPTION GCCE     -march=armv6 -mtune=arm1136j-s -fomit-frame-pointer -D__SIZEOF_POINTER__=4 -DP_HAVE_MMAP=0 \
                -D__ORDER_LITTLE_ENDIAN__=1234 -D__ORDER_BIG_ENDIAN__=4321 \
                -D__ORDER_PDP_ENDIAN__=3412 -D__BYTE_ORDER__=1234

// ari64 dynarec enabled (Stage 3). Upstream sets DRC_DISABLE only in
// the absence of DYNAREC=ari64; with ari64 BASE_ADDR_DYNAMIC=1 is needed instead,
// because the translation cache is allocated at runtime (RChunk), not reserved in .bss.
MACRO           BASE_ADDR_DYNAMIC=1
// NDRC_CONSERVATIVE_INV (flushing ALL pages instead of a range) tested on
// hardware: crash remains, while recompilations increase by an order of magnitude - this was
// what stretched track loading into seconds of continuous recompilation. Removed.

// Only for runs in EKA2L1: assembler get_reg uses uadd8/sel, which
// Dynarmic does not implement, and the thread dies on "Undefined instruction" right after
// EmuReset. With this macro the C version is used and the rest of the dynarec is tested.
// A/B on hardware completed: with the C version the crash reproduces identically, so for
// hardware we keep the assembly version.
// MACRO           NDRC_NO_ARMV6_GET_REG

SOURCEPATH      ..\..\..\pcsx_rearmed\libpcsxcore

SOURCE          cdriso.c
SOURCE          cdrom.c
SOURCE          cdrom-async.c
SOURCE          cheat.c
SOURCE          database.c
SOURCE          decode_xa.c
SOURCE          mdec.c
SOURCE          misc.c
SOURCE          plugins.c
SOURCE          ppf.c
SOURCE          psxbios.c
SOURCE          psxcommon.c
SOURCE          psxcounters.c
SOURCE          psxdma.c
SOURCE          psxevents.c
SOURCE          psxhw.c
SOURCE          psxinterpreter.c
SOURCE          psxmem.c
SOURCE          r3000a.c
SOURCE          sio.c
SOURCE          spu.c
SOURCE          gpu.c
SOURCE          pad.c
SOURCE          gte.c
SOURCE          gte_nf.c
SOURCE          gte_divider.c

// -march=armv6 enables HAVE_ARMV5 in arm_features.h, so gte.c:551 takes
// the assembly version (gteMAC123f_arm). Upstream Makefile does the same for ARCH=arm.
//
// Files are taken PREPROCESSED (..\asm), because Symbian build system passes
// assembly to the compiler with .s extension (lowercase), and for it GCC
// does NOT run the preprocessor - unlike .S. Without this, macros from arm_features.h
// do not expand: "bad instruction `function(gteRTPS_sf1lm0_arm):'".
// Regeneration - see ..\asm\regen.cmd.
SOURCEPATH      ..\asm
SOURCE          gte_arm.s
SOURCE          gte_nf_arm.s
// Stage 3: same reason for preprocessing as for gte_arm.
SOURCE          linkage_arm.s

// Dynarec composition - per upstream Makefile, branch DYNAREC=ari64.
SOURCEPATH      ..\..\..\pcsx_rearmed\libpcsxcore\new_dynarec
SOURCE          emu_if.c
SOURCE          new_dynarec.c
SOURCE          pcsxmem.c

// zlib is vendored in the repository (deps/libchdr/deps/zlib-1.3.1).
// PIPS/Open C is NOT installed in this SDK, so we build our own.
SOURCEPATH      ..\..\..\pcsx_rearmed\deps\libchdr\deps\zlib-1.3.1
SOURCE          adler32.c
SOURCE          compress.c
SOURCE          crc32.c
SOURCE          deflate.c
SOURCE          gzclose.c
SOURCE          gzlib.c
SOURCE          gzread.c
SOURCE          gzwrite.c
SOURCE          infback.c
SOURCE          inffast.c
SOURCE          inflate.c
SOURCE          inftrees.c
SOURCE          trees.c
SOURCE          uncompr.c
SOURCE          zutil.c

// Compat headers: CSL 3.4.3 and ESTLIB lack stdint.h (C99) and stdalign.h (C11).
USERINCLUDE     ..\..\..\src\compat

USERINCLUDE     ..\..\..\pcsx_rearmed
USERINCLUDE     ..\..\..\pcsx_rearmed\include
USERINCLUDE     ..\..\..\pcsx_rearmed\libpcsxcore
// Explicitly, although new_dynarec.c includes "assem_arm.h" from its own directory: the SDK
// dependency scanner searches only via USERINCLUDE, fails to find it, and via -MG
// proceeds with undefined HOST_IMM8 - up to `#error not handled` at :3650.
USERINCLUDE     ..\..\..\pcsx_rearmed\libpcsxcore\new_dynarec
USERINCLUDE     ..\..\..\pcsx_rearmed\deps\libchdr\deps\zlib-1.3.1

SYSTEMINCLUDE   \epoc32\include
SYSTEMINCLUDE   \epoc32\include\libc
