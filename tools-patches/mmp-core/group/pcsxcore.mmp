// libpcsxcore для Symbian — Етап 1: ядро з інтерпретатором, динарек вимкнено.
// Статична бібліотека: перевіряє компільованість ядра окремо від оболонки.
// Проблемні точки — docs/architecture/data-spec.md

TARGET          pcsxcore.lib
TARGETTYPE      lib

// P8: SDK не має ARMv6-платформи GCCE, ціль задається прапорцем.
// P7: __SIZEOF_POINTER__ з'явився у GCC 4.3; бандлений CSL 3.4.3 його не має.
// Порядок байтів. GCC 3.4.3 не визначає __BYTE_ORDER__ (з'явився у 4.6), а в #if
// невизначений макрос дорівнює 0, тож `__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__`
// стає `0 == 0` і ядро збиралося по BIG-ENDIAN гілці: psxmem.h:30 (доступ до
// пам'яті), r3000a.h:82 (розкладка регістрів), cdrom.c:1350. Значення — як у GCC 4.6+.
OPTION GCCE     -march=armv6 -D__SIZEOF_POINTER__=4 -DP_HAVE_MMAP=0 \
                -D__ORDER_LITTLE_ENDIAN__=1234 -D__ORDER_BIG_ENDIAN__=4321 \
                -D__ORDER_PDP_ENDIAN__=3412 -D__BYTE_ORDER__=1234

// Динарек вимкнено (Makefile upstream робить те саме за відсутності DYNAREC=ari64).
MACRO           DRC_DISABLE

SOURCEPATH      ..\..\..\pcsx_rearmed\libpcsxcore

SOURCE          cdriso.c
SOURCE          cdrom.c
SOURCE          cdrom-async.c
SOURCE          cheat.c
SOURCE          database.c
SOURCE          decode_xa.c
SOURCE          mdec.c
SOURCE          misc.c
SOURCE          plugins.c
SOURCE          ppf.c
SOURCE          psxbios.c
SOURCE          psxcommon.c
SOURCE          psxcounters.c
SOURCE          psxdma.c
SOURCE          psxevents.c
SOURCE          psxhw.c
SOURCE          psxinterpreter.c
SOURCE          psxmem.c
SOURCE          r3000a.c
SOURCE          sio.c
SOURCE          spu.c
SOURCE          gpu.c
SOURCE          pad.c
SOURCE          gte.c
SOURCE          gte_nf.c
SOURCE          gte_divider.c

// -march=armv6 вмикає HAVE_ARMV5 в arm_features.h, тож gte.c:551 бере
// асемблерну версію (gteMAC123f_arm). Upstream Makefile робить те саме для ARCH=arm.
//
// Файли беруться ПОПЕРЕДНЬО ОБРОБЛЕНІ (..\asm), бо збірна система Symbian передає
// асемблер компіляторові з розширенням .s (у нижньому регістрі), а за ним GCC
// препроцесор НЕ запускає — на відміну від .S. Без цього макроси з arm_features.h
// не розгортаються: "bad instruction `function(gteRTPS_sf1lm0_arm):'".
// Регенерація — див. ..\asm\regen.cmd.
SOURCEPATH      ..\asm
SOURCE          gte_arm.s
SOURCE          gte_nf_arm.s

SOURCEPATH      ..\..\..\pcsx_rearmed\libpcsxcore\new_dynarec
SOURCE          emu_if.c

// zlib вендорений у репозиторії (deps/libchdr/deps/zlib-1.3.1).
// PIPS/Open C у цьому SDK НЕ встановлено, тож збираємо свій.
SOURCEPATH      ..\..\..\pcsx_rearmed\deps\libchdr\deps\zlib-1.3.1
SOURCE          adler32.c
SOURCE          compress.c
SOURCE          crc32.c
SOURCE          deflate.c
SOURCE          gzclose.c
SOURCE          gzlib.c
SOURCE          gzread.c
SOURCE          gzwrite.c
SOURCE          infback.c
SOURCE          inffast.c
SOURCE          inflate.c
SOURCE          inftrees.c
SOURCE          trees.c
SOURCE          uncompr.c
SOURCE          zutil.c

// Compat-заголовки: CSL 3.4.3 та ESTLIB не мають stdint.h (C99) і stdalign.h (C11).
USERINCLUDE     ..\..\..\src\compat

USERINCLUDE     ..\..\..\pcsx_rearmed
USERINCLUDE     ..\..\..\pcsx_rearmed\include
USERINCLUDE     ..\..\..\pcsx_rearmed\libpcsxcore
USERINCLUDE     ..\..\..\pcsx_rearmed\deps\libchdr\deps\zlib-1.3.1

SYSTEMINCLUDE   \epoc32\include
SYSTEMINCLUDE   \epoc32\include\libc
