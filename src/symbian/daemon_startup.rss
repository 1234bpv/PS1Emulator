// Автозапуск демона при завантаженні через Start-up List Management.
// Скомпільований .rsc кладеться в \private\101f875a\import\ (SID сервера
// запуску sysstart); UID2 ресурсу мусить бути 0x101F8811 (KUidStartupItemInfo),
// інакше сервер його не розбере. Шлях до exe - абсолютний і сталий, тож демон
// встановлюється на C: (не знімний, доступний на момент запуску).

#include <startupitem.rh>

UID2 0x101F8811

RESOURCE STARTUP_ITEM_INFO
	{
	executable_name = "c:\\sys\\bin\\ps1daemon.exe";
	recovery = EStartupItemExPolicyNone;
	}
